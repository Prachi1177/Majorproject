<% layout("/layouts/boilerplate") %>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-3">
  <div class="col-8 offset-3"><h3><%= listing.title %></h3></div>
  <div class="card col-6 offset-3 show-card listing-card">
    <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
    <div class="card-body">
      <p class="card-text"><b><%= listing.title %></b></p>
      <p class="card-text"><%= listing.description %></p>
      <p class="card-text">&#8377; <%= listing.price.toLocaleString("en-IN") %></p>
      <p class="card-text"><%= listing.location %>, <%= listing.country %></p>
    </div>
  </div>
  <div class="col-6 offset-3 mb-3">
    <% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
    <div class="row">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-2 offset-0 edit-btn">Edit</a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="col-2">
        <button class="btn btn-dark offset-3">Delete</button>
      </form>
    </div>
    <% } %>
    <hr>
    <div class="col-8 offset-0 mb-3">
      <h4>Where you'll be</h4>
      <div id="map" style="height: 400px; width: 100%;"></div>
    </div>
  </div>
</div>
<script src="/js/map.js"></script>