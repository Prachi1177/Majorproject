<% layout("/layouts/boilerplate") %>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for(let listing of allListings){ %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="card col listing-card">
        <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e' %>" class="card-img-top" style="height:20rem">
        <div class="card-body">
          <p><b><%= listing.title %></b><br>&#8377; <%= listing.price.toLocaleString("en-IN") %> / night</p>
        </div>
      </div>
    </a>
  <% } %>
</div>